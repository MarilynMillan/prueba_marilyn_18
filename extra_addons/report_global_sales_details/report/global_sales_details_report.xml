                                                   }"/>

                                            </strong>

                                        </td>


                                    </tr>

                                </t>


                            </tbody>

                        </table>

                    </div>


                    <!-- ========================================= -->
                    <!-- ORDENES NO FACTURADAS -->
                    <!-- ========================================= -->

                    <t t-if="other_sales">


                        <div style="margin-top: 20px;">


                            <h3 style="
                                margin-bottom: 8px;
                                font-size: 14px;
                            ">
                                Órdenes de Venta (No Facturadas)
                            </h3>


                            <table class="table table-sm"
                                   style="
                                        width: 65%;
