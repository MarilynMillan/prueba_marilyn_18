                                                "
                                                   t-options="{
                                                       'widget': 'monetary',
                                                       'display_currency':
                                                       currency_usd_obj
                                                   }"/>

                                            </strong>

                                        </td>


                                    </tr>


                                </t>


                                <!-- TOTAL ORDENES DE VENTA -->

                                <t t-if="sale_products">

