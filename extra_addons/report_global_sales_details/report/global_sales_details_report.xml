                                                       'display_currency':
                                                       company.currency_id
                                                   }"/>

                                            </td>


                                            <td class="text-end"
                                                style="
                                                    padding: 4px 6px;
                                                    white-space: nowrap;
                                                ">

                                                <t t-esc="
                                                    line['price_total_usd']
                                                "
                                                   t-options="{
                                                       'widget': 'monetary',
                                                       'display_currency':
                                                       currency_usd_obj
                                                   }"/>

                                            </td>


                                        </tr>


                                    </t>


                                    <!-- SUBTOTAL CATEGORIA -->

                                    <tr style="
                                        page-break-inside: avoid;
