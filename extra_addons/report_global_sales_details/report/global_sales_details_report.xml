                                            1px solid #999;
                                    ">


                                        <td class="text-end"
                                            style="padding: 6px;">

                                            <strong>

                                                Total

                                                <t t-esc="
                                                    category['name']
                                                "/>

                                            </strong>

                                        </td>


                                        <td class="text-end"
                                            style="padding: 6px;">

                                            <strong>

                                                <t t-esc="
                                                    category['subtotal_qty']
                                                "
                                                   t-options='{
                                                       "widget": "float",
                                                       "precision": 2
                                                   }'/>

                                            </strong>

                                        </td>


                                        <td class="text-end"
