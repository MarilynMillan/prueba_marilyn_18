<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_global_sales_details_wizard_form" model="ir.ui.view">
        <field name="name">global.sales.details.wizard.form</field>
        <field name="model">global.sales.details.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Global de Detalles de Ventas">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="generate_report" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_global_sales_details_wizard" model="ir.actions.act_window">
        <field name="name">Detalle Global de Ventas</field>
        <field name="res_model">global.sales.details.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_global_sales_details_report"
              name="Detalles Globales de Ventas"
              parent="sale.menu_sale_report"
              action="action_global_sales_details_wizard"
              sequence="20"/>
</odoo>
