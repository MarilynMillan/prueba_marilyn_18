<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_details_usd_column" inherit_id="point_of_sale.pos_session_sales_details">
        
        <xpath expr="//div[@id='sales']/table/tbody/tr[1]/td[4]" position="after">
            <td class="text-end fw-bold">
            
                <t t-set="category_total_usd" t-value="category['total'] / rate_base_to_usd"/>
                <span t-out="category_total_usd" t-options='{"widget": "float", "precision": currency_usd_precision}'/>
                <span t-out="currency_usd_symbol"></span>
            </td>
        </xpath>

        <xpath expr="//div[@id='sales']/table/tbody/tr/tr/td[4]" position="after">
        <td class="text-end">
        
                <t t-set="base_total_usd" t-value="line['base_amount'] / rate_base_to_usd"/>
                <span t-out="base_total_usd" t-options='{"widget": "float", "precision": currency_usd_precision}'/>
                <span t-out="currency_usd_symbol"></span>
        </td>
        </xpath>

        <xpath expr="//div[@id='sales']/table/tbody/tr[last()]/td[4]" position="after">
            <td class="text-end">
                
                <t t-set="total_usd" t-value="products_info['total'] / rate_base_to_usd"/>
                <strong>
                    <span t-out="total_usd" t-options='{"widget": "float", "precision": currency_usd_precision}'/>
                    <span t-out="currency_usd_symbol"></span>
                </strong>
            </td>
        </xpath>

        

        <xpath expr="//div[@id='payments']//table/tbody/tr/td[2]" position="after">
            <td class="text-end">
                
                <t t-set="payment_total_usd" t-value="payment['total'] / rate_base_to_usd"/>
                <span t-out="payment_total_usd" t-options='{"widget": "float", "precision": currency_usd_precision}'/>
                <span t-out="currency_usd_symbol"></span>
            </td>
        </xpath>
        
    </template>
</odoo>